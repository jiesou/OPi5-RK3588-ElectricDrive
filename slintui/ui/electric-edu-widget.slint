import { XiaoxinPageData } from "xiaoxin-page-data.slint";
import { Palette, Button, ScrollView } from "std-widgets.slint";

// 可展开列表项
export component ListItem inherits Rectangle {
    in property <string> title;
    in property <string> desc;

    property <bool> expanded: false;

    height: expanded ? 80px : 36px;
    border-radius: 4px;
    animate height { duration: 200ms; easing: ease-in; }

    ta := TouchArea {
        clicked => { root.expanded = !root.expanded; }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        HorizontalLayout {
            height: 20px;
            spacing: 8px;

            Text {
                text: root.title;
                font-size: 20px;
                font-weight: 500;
                color: #2E7D32;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.expanded ? "▼" : "▶";
                font-size: 12px;
                color: #4CAF50;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.desc;
            font-size: 15px;
            color: #555;
            wrap: word-wrap;
            vertical-alignment: top;
            overflow: elide;
            visible: root.expanded;
        }
    }
}

// 视频封面卡片
export component VideoCard inherits Rectangle {
    in property <image> cover;
    in property <string> title;

    width: 160px;
    height: 120px;
    border-radius: 8px;
    background: #fff;
    border-width: 1px;
    border-color: #ddd;

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        Image {
            source: root.cover;
            image-fit: contain;
            horizontal-stretch: 1;
            vertical-stretch: 1;
        }

        Text {
            text: root.title;
            font-size: 12px;
            color: #333;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// 教育资源 Widget
export component ElectricEduWidget inherits Rectangle {
    callback closed;
    background: Palette.background;
    width: 100%;
    height: 100%;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // 顶部 Banner
        Rectangle {
            height: 100px;
            border-radius: 8px;
            background: @linear-gradient(135deg, #b8a7e1 0%, #2196F3 100%);
            horizontal-stretch: 1;

            Text {
                text: "电拖实训教学资源中心";
                font-size: 28px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 内容区域 - 可滚动
        ScrollView {
            horizontal-stretch: 1;
            vertical-scrollbar-policy: as-needed;

            HorizontalLayout {
                spacing: 16px;

                // 左侧：常见故障排除
                VerticalLayout {
                    alignment: start;
                    spacing: 8px;

                    Text {
                        text: "常见故障排除";
                        font-size: 18px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }

                    Rectangle {
                        border-radius: 8px;
                        background: #E8F5E9;
                        border-width: 1px;
                        border-color: #4CAF50;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            ListItem {
                                title: "电机不转";
                                desc: "检查电源连接、保险丝和电机绕组是否正常";
                            }
                            ListItem {
                                title: "电线松脱";
                                desc: "重新紧固接线端子，确保接触良好";
                            }
                            ListItem {
                                title: "PLC 报警";
                                desc: "查看报警代码，参照手册进行故障排查";
                            }
                            ListItem {
                                title: "按钮按动无反应";
                                desc: "检查按钮开关是否损坏，测试电压输出";
                            }
                            ListItem {
                                title: "指示灯不亮";
                                desc: "检查灯为什么不亮";
                            }
                        }
                    }
                }

                // 右侧：教育资源
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 8px;

                    Text {
                        text: "教育资源";
                        font-size: 18px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }

                    // 水平滚动的视频封面列表
                    ScrollView {
                        height: 140px;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: always-off;

                        HorizontalLayout {
                            spacing: 12px;
                            padding: 4px;

                            VideoCard {
                                cover: @image-url("icon/edu/1.png");
                                title: "自由的鱼-_- 2.6位置控制与自动往返控制线路";
                            }
                            VideoCard {
                                cover: @image-url("icon/edu/2.png");
                                title: "自由的鱼-_- (电工仿真)联锁正反转控制";
                            }
                            VideoCard {
                                cover: @image-url("icon/edu/3.png");
                                title: "爱学习的小刚子 电力拖动【全104讲】【含资料】【国家级精品课】";
                            }
                            VideoCard {
                                cover: @image-url("icon/edu/4.png");
                                title: "学霸戴你飞 电力拖动，运动控制系统期末速成网课视频辅导教程";
                            }
                            VideoCard {
                                cover: @image-url("icon/edu/5.png");
                                title: "小考神《电机拖动》3.7小时不挂科 | 附赠讲义";
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: #F1F8E9;
                        border-width: 1px;
                        border-color: #4CAF50;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            ListItem {
                                title: "如何进行冷态检查？";
                                desc: "断电后使用万用表测量各部件电阻值";
                            }
                            ListItem {
                                title: "如何轻松剥线？";
                                desc: "使用剥线钳，选择合适线径孔位";
                            }
                            ListItem {
                                title: "安全操作规程";
                                desc: "操作前必须断电，佩戴绝缘手套";
                            }
                        }
                    }
                }
            }
        }

    }
    // 底部关闭按钮
    Button {
        x: 10px;
        y: parent.height - self.height - 10px;
        text: "关闭";
        primary: true;
        clicked => { root.closed(); }
    }
}
