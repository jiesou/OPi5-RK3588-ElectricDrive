import { Button, GroupBox, HorizontalBox, ListView, Switch } from "std-widgets.slint";
import { EvaluationPageData } from "evaluation-page-data.slint";

export component ShotsStatusWidget {
    in property <length> root-screen-width;

    GroupBox {
        title: "拍照状态";
        height: 100%;
        width: 100%;
        VerticalLayout {
            spacing: 6px;
            Text {
                text: EvaluationPageData.current-detection-text;
                font-size: root.root-screen-width < 801px ? 14px : 20px;
                font-weight: 800;
            }
            Text {
                text: EvaluationPageData.totals-text;
                font-size: root.root-screen-width < 801px ? 14px : 20px;
                font-weight: 1600;
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: "第一张";
                    enabled: EvaluationPageData.current-shot-position != 1;
                    clicked => { EvaluationPageData.set-shot-position(1); }
                }
                Button {
                    text: "第二张";
                    enabled: EvaluationPageData.current-shot-position != 2;
                    clicked => { EvaluationPageData.set-shot-position(2); }
                }
                Button {
                    text: "第三张";
                    enabled: EvaluationPageData.current-shot-position != 3;
                    clicked => { EvaluationPageData.set-shot-position(3); }
                }
            }

            HorizontalLayout {
                Switch {
                    text: "端侧 AI 视觉推理";
                    checked <=> EvaluationPageData.inference-enabled;
                    toggled => { EvaluationPageData.toggle-inference(self.checked); }
                }
                Switch {
                    text: "UDP 图传";
                    checked <=> EvaluationPageData.udp-enabled;
                    toggled => { EvaluationPageData.toggle-udp(self.checked); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: "拍照";
                    clicked => { EvaluationPageData.capture-shot(); }
                }
                Button {
                    text: "采集";
                    clicked => { EvaluationPageData.capture-dataset(); }
                }
                Button {
                    text: "清除";
                    clicked => { EvaluationPageData.clear-shots(); }
                }
                Button {
                    text: "确认";
                    clicked => { EvaluationPageData.confirm-shots(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 40px;
                border-color: #505050;
                border-width: 2px;
                border-radius: 8px;
                clip: true;

                ListView {
                    height: 100%;
                    width: 100%;
                    for s in EvaluationPageData.shots : Text {
                        text: s;
                    }
                }
            }
        }
    }
}
