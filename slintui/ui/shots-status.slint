import { Button, VerticalBox, HorizontalBox, GroupBox, CheckBox, ListView, Switch } from "std-widgets.slint";

export component ShotsStatusWidget {
    in property <string> current-detection-text;
    in property <string> totals-text;

    in-out property <int> current-shot-position: 1;
    in-out property <bool> inference-enabled: false;
    in-out property <bool> udp-enabled: false;
    in property <[string]> shots;

    callback set-shot-position(int);
    callback toggle-inference(bool);
    callback toggle-udp(bool);
    callback capture-dataset();
    callback capture-shot();
    callback clear-shots();
    callback confirm-shots();

    GroupBox {
        title: "拍照状态";
        height: 100%;
        width: 100%;
        VerticalLayout {
            spacing: 6px;
            visible: true;
            Text {
                text: root.current-detection-text;
                font-size: 16px;
                font-weight: 800;
            }
            Text {
                text: root.totals-text;
                font-size: 16px;
                font-weight: 1600;
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: "第一张";
                    enabled: root.current-shot-position != 1;
                    clicked => { root.set-shot-position(1); }
                }
                Button {
                    text: "第二张";
                    enabled: root.current-shot-position != 2;
                    clicked => { root.set-shot-position(2); }
                }
                Button {
                    text: "第三张";
                    enabled: root.current-shot-position != 3;
                    clicked => { root.set-shot-position(3); }
                }
            }

            HorizontalLayout {
                Switch {
                    text: "端侧 AI 视觉推理";
                    checked <=> root.inference-enabled;
                    toggled => { root.toggle-inference(self.checked); }
                }

                Switch {
                    text: "UDP 图传";
                    checked <=> root.udp-enabled;
                    toggled => { root.toggle-udp(self.checked); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: "拍照";
                    clicked => { root.capture-shot(); }
                }
                Button {
                    text: "采集";
                    clicked => { root.capture-dataset(); }
                }
                Button {
                    text: "清除";
                    clicked => { root.clear-shots(); }
                }
                Button {
                    text: "确认";
                    clicked => { root.confirm-shots(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 40px;
                border-color: #505050;
                border-width: 2px;
                border-radius: 8px;
                clip: true;

                ListView {
                    height: 100%;
                    width: 100%;
                    for s in root.shots : Text {
                        text: s;
                    }
                }
            }
        }
    }
}
