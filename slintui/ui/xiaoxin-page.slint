import { XiaoxinPageData } from "xiaoxin-page-data.slint";
import { CameraViewport } from "camera-viewport.slint";
import { Palette, Button } from "std-widgets.slint";
import { ElectricEduWidget } from "electric-edu-widget.slint";

// 故障主动发现弹窗
component TroubleshootPopup inherits Rectangle {
    background: Palette.background;
    border-radius: 16px;
    border-width: 2px;
    border-color: #4CAF50;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 80px;
                height: 80px;
                border-radius: 40px;
                background: #4CAF50;
                horizontal-stretch: 0;

                Text {
                    text: "!";
                    font-size: 48px;
                    font-weight: 800;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: XiaoxinPageData.troubleshoot-title;
                font-size: 32px;
                font-weight: 600;
                y: 16px;
                color: Palette.foreground;
                horizontal-alignment: center;
                wrap: word-wrap;
                width: parent.width - 48px;
            }
        }

        HorizontalLayout {
            spacing: 16px;
            horizontal-stretch: 0;

            Button {
                text: "帮帮我";
                primary: true;
                clicked => {
                    XiaoxinPageData.help-me-solve();
                    XiaoxinPageData.show-troubleshoot-popup = false;
                    XiaoxinPageData.show-troubleshoot-solution-popup = true;
                }
            }

            Button {
                text: "我会自己解决";
                clicked => {
                    XiaoxinPageData.show-troubleshoot-popup = false;
                    XiaoxinPageData.status-type = "idle";
                }
            }
        }
    }
}

// 故障解决方案弹窗
component SolutionPopup inherits Rectangle {
    background: Palette.background;
    border-radius: 16px;
    border-width: 2px;
    border-color: #2196F3;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "小新智能体提醒你";
            font-size: 24px;
            font-weight: 700;
            color: Palette.foreground;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground;
        }

        Text {
            text: XiaoxinPageData.troubleshoot-solution-desc;
            font-size: 18px;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: word-wrap;
            width: parent.width - 60px;
        }

        Rectangle {
            height: 8px;
        }

        Button {
            text: "我知道了";
            primary: true;
            clicked => {
                XiaoxinPageData.show-troubleshoot-solution-popup = false;
                XiaoxinPageData.status-type = "idle";
            };
        }
    }
}

export component XiaoxinPage {
    in property <length> root-screen-width;
    height: 100%;
    width: 100%;

    private property <bool> is-portrait: root.height > root.width;

    // 主页面背景
    Rectangle {
        background: Palette.background;

        // 左侧小新智能体提示
        VerticalLayout {
            spacing: 24px;
            alignment: center;
            width: is-portrait ? root.width : (root.root-screen-width < 801px ? root.width / 2.1 : root.width / 1.7);
            height: is-portrait ? root.height * 0.5 : root.height;
            x: 0;
            y: 0;

            // 智能体头像区域（可点击）
            Rectangle {
                width: 160px;
                height: 160px;
                x: (parent.width - self.width) / 2;
                border-radius: 80px;
                background: @linear-gradient(135deg, Palette.accent-background 0%, #2196f3 100%);
                horizontal-stretch: 0;

                // 点击区域
                TouchArea {
                    clicked => { XiaoxinPageData.show-edu-widget = true; }
                }

                // 内圈
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 140px;
                    height: 140px;
                    border-radius: 70px;
                    background: Palette.background;
                    clip: true;
                    Image {
                        width: 140px;
                        height: 140px;
                        source: @image-url("icon/xiaoxin.png");
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: "小新智能体准备就绪";
                font-size: 36px;
                font-weight: 800;
                color: Palette.foreground;
                horizontal-alignment: center;
            }

            // 装饰分隔线
            Rectangle {
                in-out property <bool> anim_end;
                x: (parent.width - self.width) / 2;
                width: anim_end ? parent.width * 0.9 : parent.width * 0.4;
                height: 8px;
                background: anim_end ? @linear-gradient(90deg, transparent 0%, #d0bcff 30%, #2196f3 50%, #d0bcff 70%, transparent 100%) :
                    @linear-gradient(90deg, transparent 0%, #d0bcff 10%, #2196f3 50%, #d0bcff 90%, transparent 100%);
                animate background, width {
                    duration: 1000ms;
                    easing: ease-in-out;
                }
                Timer {
                    interval: 1000ms;
                    running: true;
                    triggered() => {
                        parent.anim_end = !parent.anim_end;
                    }
                }
            }
        }

        // 顶部
        Text {
            x: 8px;
            y: 8px;
            text: "电拖实训端侧 AI 平台";
            font-size: 24px;
            font-weight: 600;
            color: Palette.foreground;
        }


        // 右侧摄像头画面
        VerticalLayout {
            width: is-portrait ? root.width : (root.root-screen-width < 801px ? root.width / 1.9 : root.width / 2.45);
            height: is-portrait ? root.height * 0.5 : root.height;
            x: is-portrait ? 0 : root.width - self.width;
            y: is-portrait ? root.height * 0.5 : 0;

            CameraViewport {
                width: 100%;
                height: 100%;
                frame: XiaoxinPageData.camera-frame;
                running: XiaoxinPageData.xiaoxin-running;
                request-camera-frame => { XiaoxinPageData.request-xiaoxin-frame(); }
            }
        }
    }

    // 教育资源 Widget（点击头像展开）
    Rectangle {
        visible: XiaoxinPageData.show-edu-widget;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        ElectricEduWidget { }
    }

    // 故障发现弹窗（主动弹窗）
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-popup;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 400px;
        height: 260px;

        TroubleshootPopup {
        }
    }

    // 故障解决方案弹窗
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-solution-popup;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 400px;
        height: 380px;
        SolutionPopup {
        }
    }
}
