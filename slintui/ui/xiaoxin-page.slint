import { XiaoxinPageData } from "xiaoxin-page-data.slint";
import { CameraViewport } from "camera-viewport.slint";
import { Palette, Button, StyleMetrics } from "std-widgets.slint";
import { ElectricEduWidget } from "electric-edu-widget.slint";
import { Sizing } from "sizing.slint";
import { RadarChart } from "radar-chart.slint";

// 故障主动发现弹窗
component TroubleshootPopup inherits Rectangle {
    background: Palette.background;
    width: Sizing.screen-width * 60%;
    height: Sizing.screen-height * 40%;
    border-radius: 16px;
    border-width: 2px;
    border-color: #4CAF50;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        // alignment: start;

            Text {
                x: parent.x + parent.width;
                text: XiaoxinPageData.troubleshoot-title;
                font-size: Sizing.large * 50%;
                font-weight: 600;
                color: Palette.foreground;
                horizontal-alignment: center;
                wrap: word-wrap;
                width: parent.width - 48px;
            }

        HorizontalLayout {
            spacing: StyleMetrics.layout-spacing;

            Button {
                text: "帮帮我";
                primary: true;
                clicked => {
                    XiaoxinPageData.show-troubleshoot-popup = false;
                    XiaoxinPageData.show-troubleshoot-solution-popup = true;
                }
            }

            Button {
                text: "我会自己解决";
                clicked => {
                    XiaoxinPageData.show-troubleshoot-popup = false;
                }
            }
        }
    }
}

// 故障解决方案弹窗
component SolutionPopup inherits Rectangle {
    background: Palette.background;
    width: Sizing.screen-width * 50%;
    height: Sizing.screen-height * 80%;
    border-radius: 16px;
    border-width: 2px;
    border-color: #2196F3;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "小新智能体提醒你";
            font-weight: 700;
            color: Palette.foreground;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground;
        }

        Text {
            text: XiaoxinPageData.troubleshoot-solution-desc;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: word-wrap;
            width: parent.width - 60px;
        }

        Rectangle {
            height: 8px;
        }

        Button {
            text: "我知道了";
            primary: true;
            clicked => {
                XiaoxinPageData.show-troubleshoot-solution-popup = false;
            };
        }
    }
}

export component XiaoxinPage {
    in property <length> root-screen-width;
    height: 100%;
    width: 100%;

    private property <bool> is-portrait: root.height > root.width;
    property <length> left-panel-width: root.width / 3 * 1.8;

    // 核心状态：小新头已展开
    in-out property <bool> expanded: false;

    // 主页面
    Rectangle {
        background: Palette.background;

        // 顶部标题
        top-title := Text {
            x: 8px;
            y: 8px;
            text: "小新智能体学生端 端侧 AI";
            font-weight: 600;
            color: Palette.foreground;
            opacity: expanded ? 0 : 1;
            animate opacity { duration: 200ms; }
        }

        // 装饰分隔线
        Rectangle {
            in-out property <bool> anim_end;
            x: (left-panel-width - self.width) / 2;
            y: top-title.y + top-title.height + StyleMetrics.layout-spacing;
            height: 8px;
            states [
                idle when !anim_end: {
                    width: parent.width * 0.5 * 0.7;
                    background: @linear-gradient(90deg, transparent 0%, #d0bcff 10%, #2196f3 50%, #d0bcff 90%, transparent 100%);
                }
                anim_end when anim_end: {
                    width: parent.width * 0.5 * 0.9;
                    background: @linear-gradient(90deg, transparent 0%, #d0bcff 20%, #2196f3 50%, #d0bcff 80%, transparent 100%);
                }
            ]
            animate background, width {
                duration: 1000ms;
                easing: ease-in-out;
            }
            Timer {
                interval: 1000ms;
                triggered() => {
                    parent.anim_end = !parent.anim_end;
                }
            }

            opacity: expanded ? 0 : 1;
            animate opacity { duration: 200ms; }
        }

        // 左侧内容面板
        VerticalLayout {
            alignment: end;
            width: left-panel-width;
            x: 0;
            padding-bottom: Sizing.large * 30%;
            opacity: expanded ? 0 : 1;
            animate opacity { duration: 200ms; }

            status-text := Text {
                text: XiaoxinPageData.status-text;
                font-weight: 500;
                color: @linear-gradient(135deg, Palette.accent-background 0%, #2196f3 100%);
                horizontal-alignment: center;
                font-size: Sizing.large * 50%;
            }

            Rectangle {
                in-out property <int> anim_step: 0;
                background: Palette.alternate-background;
                width: parent.width * 0.95;
                height: Sizing.xlarge;
                x: (parent.width - self.width) / 2;
                border-radius: Sizing.xlarge;
                border-color: Palette.alternate-foreground.darker(0.8);
                border-width: 2px;
                clip: true;

                Text {
                    text: XiaoxinPageData.insights-text;
                    font-size: XiaoxinPageData.insights-text.character-count > 6 ? Sizing.large * 70% : Sizing.large;
                    font-weight: 800;

                    y: (parent.height - self.height) / 2;
                    
                    states [
                        anim_0 when anim_step == 0: {
                            color: @linear-gradient(90deg, transparent 0%, Palette.alternate-foreground 0%, Palette.alternate-foreground 100%);
                            out {
                                animate color {
                                    duration: 2000ms;
                                    easing: ease-in;
                                }
                            }
                        }
                        anim_1 when anim_step == 1: {
                            color: @linear-gradient(90deg, Palette.alternate-foreground 0%, transparent 100%, Palette.alternate-foreground 100%);
                            out {
                                animate color {
                                    duration: 2000ms;
                                    easing: ease-in;
                                }
                            }
                        }
                        anim_2 when anim_step == 2: {
                            color: Palette.alternate-foreground;
                        }
                    ]
                }
                Timer {
                    interval: 2000ms;
                    triggered() => {
                        parent.anim_step = Math.mod(parent.anim_step + 1, 3);
                    }
                }
            }
        }

        // 右侧面板：VL 模型分析 + 摄像头画面
        VerticalLayout {
            width: root.width - left-panel-width;
            x: root.width - self.width;
            opacity: expanded ? 0 : 1;
            animate opacity { duration: 200ms; }

            // VL 模型响应区域
            Rectangle {
                width: 100%;
                background: Palette.background;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Rectangle {
                        width: 50px;
                        height: 50px;
                        border-radius: 50px;
                        background: XiaoxinPageData.vl-is-streaming ? #4CAF50 : Palette.alternate-background;
                    }

                    Rectangle {
                        clip: true;

                        Text {
                            text: XiaoxinPageData.vl-response-text;
                            font-size: Sizing.small * 50%;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            x: 8px;
                            y: min(6px, parent.height - self.height - 6px);
                            width: parent.width - 16px;
                        }
                    }
                }
            }

            // 摄像头画面（底部，16:9 宽高比避免黑边）
            CameraViewport {
                width: 100%;
                height: parent.width / 16 * 9;
                frame: XiaoxinPageData.camera-frame;
                running: XiaoxinPageData.xiaoxin-running;
                request-camera-frame => {
                    XiaoxinPageData.request-xiaoxin-frame();
                }
            }
        }
    }

    // === 小新动画智能提示文字 ===
    Rectangle {
        width: root.width;
        height: 80px;
        y: parent.height - self.height - 30px;

        states [
            hidden when !expanded || XiaoxinPageData.show-edu-widget: {
                opacity: 0;
            }
            visible-state when expanded && !XiaoxinPageData.show-edu-widget: {
                opacity: 1;
                in {
                    animate opacity {
                        duration: 300ms;
                        delay: 300ms;
                    }
                }
            }
        ]

        Rectangle {
            background: Palette.background.with-alpha(0.3);
            Text {
                text: "小新在呢，需要什么帮助？";
                font-size: Sizing.large;
                font-weight: 800;
                color: Palette.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // 定时器：展开后延迟显示 Edu Widget
    Timer {
        interval: 3000ms;
        running: expanded && !XiaoxinPageData.show-edu-widget;
        triggered() => {
            XiaoxinPageData.show-edu-widget = true;
        }
    }

    // === 教育资源 Edu Widget ===
    Rectangle {
        background: Palette.background;
        states [
            hidden when !XiaoxinPageData.show-edu-widget: {
                width: root.width * 0.8;
                height: root.height * 0.8;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                opacity: 0;
            }
            visible-state when XiaoxinPageData.show-edu-widget: {
                width: root.width;
                height: root.height;
                opacity: 1;
                in {
                    animate width, height, x, y, opacity {
                        duration: 300ms;
                        easing: ease-out;
                    }
                }
            }
        ]

        ElectricEduWidget {
            property <bool> closing: false;
            closed => {
                XiaoxinPageData.show-edu-widget = false;
                // expanded = false;
                closing = true;
            }
            Timer {
                interval: 300ms;
                running: parent.closing;
                triggered() => {
                    expanded = false;
                    closing = false;
                }
            }
        }
    }

    insight_7s_desc := Rectangle {
        width: Sizing.screen-width * 30%;
        height: self.width;
        x: (left-panel-width - self.width) - left-panel-width * 5%;
        y:  status-text.y - self.height + Sizing.large * 40%;

        RadarChart {
            axes: XiaoxinPageData.insight_7s_data;
        }

        states [
            idle when !expanded: { opacity: 1; in-out { animate opacity { duration: 300ms; } } }
            hide when expanded: { opacity: 0; }
        ]
    }

    // === 故障发现 ===
    // 故障主动发现弹窗
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-popup;
        troubleshoot-popup := TroubleshootPopup { }
    }

    // 故障解决方案弹窗
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-solution-popup;
        troubleshoot-solution-popup := SolutionPopup { }
    }

    // === 小新动画头像 ===
    avatar := Rectangle {
        border-radius: Sizing.xlarge * 320%;
        background: @linear-gradient(135deg, Palette.accent-background 0%, #2196f3 100%);

        states [
            float-troubleshoot-popup when XiaoxinPageData.show-troubleshoot-popup: {
                width: Sizing.large;
                height: Sizing.large;
                x: troubleshoot-popup.x + 10px;
                y: troubleshoot-popup.y + 10px;
                opacity: 1;
                in-out {
                    animate width, height, x, y {
                        duration: 500ms;
                        easing: ease-in-out;
                    }
                }
            }
            float-troubleshoot-solution-popup when XiaoxinPageData.show-troubleshoot-solution-popup: {
                width: Sizing.large;
                height: Sizing.large;
                x: troubleshoot-solution-popup.x + 10px;
                y: troubleshoot-solution-popup.y + 10px;
                opacity: 1;
                in {
                    animate width, height, x, y {
                        duration: 500ms;
                        easing: ease-in-out;
                    }
                }
            }
            idle when !expanded: {
                width: Sizing.xlarge * 160%;
                height: Sizing.xlarge * 160%;
                x: (left-panel-width - self.width) * 15%;
                y: status-text.y - self.height - StyleMetrics.layout-spacing * 250%;
                opacity: 1;
            }
            expanded when expanded && !XiaoxinPageData.show-edu-widget: {
                width: Sizing.xlarge * 320%;
                height: Sizing.xlarge * 320%;
                x: (root.width - self.width) / 2;
                y: StyleMetrics.layout-spacing * 250% ;
                opacity: 1;
                in-out {
                    animate width, height {
                        duration: 700ms;
                        easing: ease-out;
                    }
                    animate x, y {
                        duration: 1500ms;
                        easing: ease-in-out;
                    }
                }
            }
            faded when XiaoxinPageData.show-edu-widget: {
                width: Sizing.xlarge * 320%;
                height: Sizing.xlarge * 320%;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                opacity: 0;
                in-out {
                    animate opacity { duration: 300ms; }
                }
            }
        ]

        ta := TouchArea {
            clicked => {
                expanded = true;
            }
        }

        Rectangle {
            border-radius: parent.border-radius;
            clip: true;
            // states [
            //     normal when !ta.pressed: {
                    width: parent.width - 20px;
                    height: parent.height - 20px;
            //     }
            //     pressed when ta.pressed: {
            //         width: parent.width * 70%;
            //         height: parent.height * 70%;
            //     }
            // ]
            // animate width, height { duration: 20ms; }
            Image {
                width: 100%;
                height: 100%;
                source: @image-url("icon/xiaoxin.png");
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
