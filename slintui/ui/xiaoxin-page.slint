import { XiaoxinPageData, Insight7SItem } from "xiaoxin-page-data.slint";
import { CameraViewport } from "camera-viewport.slint";
import { Palette, Button, StyleMetrics } from "std-widgets.slint";
import { ElectricEduWidget } from "electric-edu-widget.slint";
import { Sizing } from "sizing.slint";

// 故障主动发现弹窗
component TroubleshootPopup inherits Rectangle {
    background: Palette.background;
    width: Sizing.screen-width * 60%;
    height: Sizing.screen-height * 40%;
    border-radius: 16px;
    border-width: 2px;
    border-color: #4CAF50;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        // alignment: start;

            Text {
                x: parent.x + parent.width;
                text: XiaoxinPageData.troubleshoot-title;
                font-size: Sizing.large * 50%;
                font-weight: 600;
                color: Palette.foreground;
                horizontal-alignment: center;
                wrap: word-wrap;
                width: parent.width - 48px;
            }

        HorizontalLayout {
            spacing: StyleMetrics.layout-spacing;

            Button {
                text: "帮帮我";
                primary: true;
                clicked => {
                    XiaoxinPageData.show-troubleshoot-popup = false;
                    XiaoxinPageData.show-troubleshoot-solution-popup = true;
                }
            }

            Button {
                text: "我会自己解决";
                clicked => {
                    XiaoxinPageData.show-troubleshoot-popup = false;
                }
            }
        }
    }
}

// 故障解决方案弹窗
component SolutionPopup inherits Rectangle {
    background: Palette.background;
    width: Sizing.screen-width * 50%;
    height: Sizing.screen-height * 80%;
    border-radius: 16px;
    border-width: 2px;
    border-color: #2196F3;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "小新智能体提醒你";
            font-weight: 700;
            color: Palette.foreground;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground;
        }

        Text {
            text: XiaoxinPageData.troubleshoot-solution-desc;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: word-wrap;
            width: parent.width - 60px;
        }

        Rectangle {
            height: 8px;
        }

        Button {
            text: "我知道了";
            primary: true;
            clicked => {
                XiaoxinPageData.show-troubleshoot-solution-popup = false;
            };
        }
    }
}

export component XiaoxinPage {
    in property <length> root-screen-width;
    height: 100%;
    width: 100%;

    private property <bool> is-portrait: root.height > root.width;
    property <length> left-panel-width: root.width / 3 * 1.8;

    // 核心状态：小新头已展开
    in-out property <bool> expanded: false;

    // 主页面
    Rectangle {
        background: Palette.background;

        // 顶部标题
        top-title := Text {
            x: 8px;
            y: 8px;
            text: "电拖实训端侧 AI 平台";
            font-weight: 600;
            color: Palette.foreground;
            opacity: expanded ? 0 : 1;
            animate opacity { duration: 200ms; }
        }

        // 装饰分隔线
        Rectangle {
            in-out property <bool> anim_end;
            x: (left-panel-width - self.width) / 2;
            y: top-title.y + top-title.height + StyleMetrics.layout-spacing;
            height: 8px;
            states [
                idle when !anim_end: {
                    width: parent.width * 0.5 * 0.7;
                    background: @linear-gradient(90deg, transparent 0%, #d0bcff 10%, #2196f3 50%, #d0bcff 90%, transparent 100%);
                }
                anim_end when anim_end: {
                    width: parent.width * 0.5 * 0.9;
                    background: @linear-gradient(90deg, transparent 0%, #d0bcff 20%, #2196f3 50%, #d0bcff 80%, transparent 100%);
                }
            ]
            animate background, width {
                duration: 1000ms;
                easing: ease-in-out;
            }
            Timer {
                interval: 1000ms;
                triggered() => {
                    parent.anim_end = !parent.anim_end;
                }
            }

            opacity: expanded ? 0 : 1;
            animate opacity { duration: 200ms; }
        }

        // 左侧内容面板
        VerticalLayout {
            alignment: center;
            width: left-panel-width;
            x: 0;
            padding-top: Sizing.xlarge * 180%;
            opacity: expanded ? 0 : 1;
            animate opacity { duration: 200ms; }

            Text {
                text: XiaoxinPageData.status-text;
                font-weight: 500;
                color: @linear-gradient(135deg, Palette.accent-background 0%, #2196f3 100%);
                horizontal-alignment: center;
                font-size: Sizing.large * 50%;
            }

            Rectangle {
                in-out property <int> anim_step: 0;
                background: Palette.alternate-background;
                width: parent.width * 0.95;
                height: Sizing.xlarge;
                x: (parent.width - self.width) / 2;
                border-radius: Sizing.xlarge;
                border-color: Palette.alternate-foreground.darker(0.8);
                border-width: 2px;
                clip: true;

                Text {
                    text: XiaoxinPageData.insights-text;
                    font-size: Sizing.large;
                    font-weight: 800;

                    y: (parent.height - self.height) / 2;
                    
                    states [
                        anim_0 when anim_step == 0: {
                            color: @linear-gradient(90deg, transparent 0%, Palette.alternate-foreground 0%, Palette.alternate-foreground 100%);
                            out {
                                animate color {
                                    duration: 2000ms;
                                    easing: ease-in;
                                }
                            }
                        }
                        anim_1 when anim_step == 1: {
                            color: @linear-gradient(90deg, Palette.alternate-foreground 0%, transparent 100%, Palette.alternate-foreground 100%);
                            out {
                                animate color {
                                    duration: 2000ms;
                                    easing: ease-in;
                                }
                            }
                        }
                        anim_2 when anim_step == 2: {
                            color: Palette.alternate-foreground;
                        }
                    ]
                }
                Timer {
                    interval: 2000ms;
                    triggered() => {
                        parent.anim_step = Math.mod(parent.anim_step + 1, 3);
                    }
                }
            }
        }

        // 右侧摄像头画面
        VerticalLayout {
            width: root.width - left-panel-width;
            x: root.width - self.width;

            CameraViewport {
                width: 100%;
                height: 100%;
                frame: XiaoxinPageData.camera-frame;
                running: XiaoxinPageData.xiaoxin-running;
                request-camera-frame => {
                    XiaoxinPageData.request-xiaoxin-frame();
                }
            }
        }
    }

    // === 小新动画智能提示文字 ===
    Rectangle {
        width: root.width;
        height: 80px;
        y: parent.height - self.height - 30px;

        states [
            hidden when !expanded || XiaoxinPageData.show-edu-widget: {
                opacity: 0;
            }
            visible-state when expanded && !XiaoxinPageData.show-edu-widget: {
                opacity: 1;
                in {
                    animate opacity {
                        duration: 300ms;
                        delay: 300ms;
                    }
                }
            }
        ]

        Rectangle {
            background: Palette.background.with-alpha(0.3);
            Text {
                text: "小新在呢，需要什么帮助？";
                font-size: Sizing.large;
                font-weight: 800;
                color: Palette.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // 定时器：展开后延迟显示 Edu Widget
    Timer {
        interval: 3000ms;
        running: expanded && !XiaoxinPageData.show-edu-widget;
        triggered() => {
            XiaoxinPageData.show-edu-widget = true;
        }
    }

    // === 教育资源 Edu Widget ===
    Rectangle {
        background: Palette.background;
        states [
            hidden when !XiaoxinPageData.show-edu-widget: {
                width: root.width * 0.8;
                height: root.height * 0.8;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                opacity: 0;
            }
            visible-state when XiaoxinPageData.show-edu-widget: {
                width: root.width;
                height: root.height;
                opacity: 1;
                in {
                    animate width, height, x, y, opacity {
                        duration: 300ms;
                        easing: ease-out;
                    }
                }
            }
        ]

        ElectricEduWidget {
            property <bool> closing: false;
            closed => {
                XiaoxinPageData.show-edu-widget = false;
                // expanded = false;
                closing = true;
            }
            Timer {
                interval: 300ms;
                running: parent.closing;
                triggered() => {
                    expanded = false;
                    closing = false;
                }
            }
        }
    }

    // === 故障发现 ===
    // 故障主动发现弹窗
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-popup;
        troubleshoot-popup := TroubleshootPopup { }
    }

    // 故障解决方案弹窗
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-solution-popup;
        troubleshoot-solution-popup := SolutionPopup { }
    }

//     Timer {
//     running: true;
//     interval: 1000ms;
//     triggered => { XiaoxinPageData.show-troubleshoot-popup = true; self.running = false; }
// }

    // === 7S 雷达图 ===
    radar-chart := Rectangle {
        width: Sizing.xlarge * 280%;
        height: Sizing.xlarge * 160%;
        x: (left-panel-width - self.width) - left-panel-width * 5%;
        y: top-title.y + top-title.height + StyleMetrics.layout-spacing * 250%;

        // 7S 标签
        label-0 := Text {
            visible: XiaoxinPageData.insight_7s_data.length > 0;
            text: XiaoxinPageData.insight_7s_data[0].title;
            font-size: Sizing.small * 55%;
            color: Palette.foreground;
            horizontal-alignment: center;
            x: { let a = -1.57079633rad; let r = parent.width / 2 * 0.85 + 18px; parent.width / 2 + r * Math.cos(a) - self.width / 2 }
            y: { let a = -1.57079633rad; let r = parent.width / 2 * 0.85 + 18px; parent.height / 2 + r * Math.sin(a) - self.height / 2 }
        }
        label-1 := Text {
            visible: XiaoxinPageData.insight_7s_data.length > 1;
            text: XiaoxinPageData.insight_7s_data[1].title;
            font-size: Sizing.small * 55%;
            color: Palette.foreground;
            horizontal-alignment: center;
            x: { let a = -0.67319842rad; let r = parent.width / 2 * 0.85 + 18px; parent.width / 2 + r * Math.cos(a) - self.width / 2 }
            y: { let a = -0.67319842rad; let r = parent.width / 2 * 0.85 + 18px; parent.height / 2 + r * Math.sin(a) - self.height / 2 }
        }
        label-2 := Text {
            visible: XiaoxinPageData.insight_7s_data.length > 2;
            text: XiaoxinPageData.insight_7s_data[2].title;
            font-size: Sizing.small * 55%;
            color: Palette.foreground;
            horizontal-alignment: center;
            x: { let a = 0.22439948rad; let r = parent.width / 2 * 0.85 + 18px; parent.width / 2 + r * Math.cos(a) - self.width / 2 }
            y: { let a = 0.22439948rad; let r = parent.width / 2 * 0.85 + 18px; parent.height / 2 + r * Math.sin(a) - self.height / 2 }
        }
        label-3 := Text {
            visible: XiaoxinPageData.insight_7s_data.length > 3;
            text: XiaoxinPageData.insight_7s_data[3].title;
            font-size: Sizing.small * 55%;
            color: Palette.foreground;
            horizontal-alignment: center;
            x: { let a = 1.12199738rad; let r = parent.width / 2 * 0.85 + 18px; parent.width / 2 + r * Math.cos(a) - self.width / 2 }
            y: { let a = 1.12199738rad; let r = parent.width / 2 * 0.85 + 18px; parent.height / 2 + r * Math.sin(a) - self.height / 2 }
        }
        label-4 := Text {
            visible: XiaoxinPageData.insight_7s_data.length > 4;
            text: XiaoxinPageData.insight_7s_data[4].title;
            font-size: Sizing.small * 55%;
            color: Palette.foreground;
            horizontal-alignment: center;
            x: { let a = 2.01959527rad; let r = parent.width / 2 * 0.85 + 18px; parent.width / 2 + r * Math.cos(a) - self.width / 2 }
            y: { let a = 2.01959527rad; let r = parent.width / 2 * 0.85 + 18px; parent.height / 2 + r * Math.sin(a) - self.height / 2 }
        }
        label-5 := Text {
            visible: XiaoxinPageData.insight_7s_data.length > 5;
            text: XiaoxinPageData.insight_7s_data[5].title;
            font-size: Sizing.small * 55%;
            color: Palette.foreground;
            horizontal-alignment: center;
            x: { let a = 2.91719317rad; let r = parent.width / 2 * 0.85 + 18px; parent.width / 2 + r * Math.cos(a) - self.width / 2 }
            y: { let a = 2.91719317rad; let r = parent.width / 2 * 0.85 + 18px; parent.height / 2 + r * Math.sin(a) - self.height / 2 }
        }
        label-6 := Text {
            visible: XiaoxinPageData.insight_7s_data.length > 6;
            text: XiaoxinPageData.insight_7s_data[6].title;
            font-size: Sizing.small * 55%;
            color: Palette.foreground;
            horizontal-alignment: center;
            x: { let a = -2.46839094rad; let r = parent.width / 2 * 0.85 + 18px; parent.width / 2 + r * Math.cos(a) - self.width / 2 }
            y: { let a = -2.46839094rad; let r = parent.width / 2 * 0.85 + 18px; parent.height / 2 + r * Math.sin(a) - self.height / 2 }
        }

        // 网格层 33%
        grid-33 := Path {
            x: 0; y: 0; width: parent.width; height: parent.height;
            stroke: Palette.foreground.with-alpha(0.12); stroke-width: 1px; fill: transparent;
            commands: {
                let cx = parent.width / 2 / 1px; let cy = parent.height / 2 / 1px; let r = parent.width / 2 * 0.85 / 1px * 0.33;
                "M " + (cx + r * Math.cos(-1.57079633rad)) + " " + (cy + r * Math.sin(-1.57079633rad)) +
                " L " + (cx + r * Math.cos(-0.67319842rad)) + " " + (cy + r * Math.sin(-0.67319842rad)) +
                " L " + (cx + r * Math.cos(0.22439948rad)) + " " + (cy + r * Math.sin(0.22439948rad)) +
                " L " + (cx + r * Math.cos(1.12199738rad)) + " " + (cy + r * Math.sin(1.12199738rad)) +
                " L " + (cx + r * Math.cos(2.01959527rad)) + " " + (cy + r * Math.sin(2.01959527rad)) +
                " L " + (cx + r * Math.cos(2.91719317rad)) + " " + (cy + r * Math.sin(2.91719317rad)) +
                " L " + (cx + r * Math.cos(-2.46839094rad)) + " " + (cy + r * Math.sin(-2.46839094rad)) + " Z"
            }
        }
        // 网格层 66%
        grid-66 := Path {
            x: 0; y: 0; width: parent.width; height: parent.height;
            stroke: Palette.foreground.with-alpha(0.12); stroke-width: 1px; fill: transparent;
            commands: {
                let cx = parent.width / 2 / 1px; let cy = parent.height / 2 / 1px; let r = parent.width / 2 * 0.85 / 1px * 0.66;
                "M " + (cx + r * Math.cos(-1.57079633rad)) + " " + (cy + r * Math.sin(-1.57079633rad)) +
                " L " + (cx + r * Math.cos(-0.67319842rad)) + " " + (cy + r * Math.sin(-0.67319842rad)) +
                " L " + (cx + r * Math.cos(0.22439948rad)) + " " + (cy + r * Math.sin(0.22439948rad)) +
                " L " + (cx + r * Math.cos(1.12199738rad)) + " " + (cy + r * Math.sin(1.12199738rad)) +
                " L " + (cx + r * Math.cos(2.01959527rad)) + " " + (cy + r * Math.sin(2.01959527rad)) +
                " L " + (cx + r * Math.cos(2.91719317rad)) + " " + (cy + r * Math.sin(2.91719317rad)) +
                " L " + (cx + r * Math.cos(-2.46839094rad)) + " " + (cy + r * Math.sin(-2.46839094rad)) + " Z"
            }
        }
        // 网格层 100%
        grid-100 := Path {
            x: 0; y: 0; width: parent.width; height: parent.height;
            stroke: Palette.foreground.with-alpha(0.12); stroke-width: 1px; fill: transparent;
            commands: {
                let cx = parent.width / 2 / 1px; let cy = parent.height / 2 / 1px; let r = parent.width / 2 * 0.85 / 1px;
                "M " + (cx + r * Math.cos(-1.57079633rad)) + " " + (cy + r * Math.sin(-1.57079633rad)) +
                " L " + (cx + r * Math.cos(-0.67319842rad)) + " " + (cy + r * Math.sin(-0.67319842rad)) +
                " L " + (cx + r * Math.cos(0.22439948rad)) + " " + (cy + r * Math.sin(0.22439948rad)) +
                " L " + (cx + r * Math.cos(1.12199738rad)) + " " + (cy + r * Math.sin(1.12199738rad)) +
                " L " + (cx + r * Math.cos(2.01959527rad)) + " " + (cy + r * Math.sin(2.01959527rad)) +
                " L " + (cx + r * Math.cos(2.91719317rad)) + " " + (cy + r * Math.sin(2.91719317rad)) +
                " L " + (cx + r * Math.cos(-2.46839094rad)) + " " + (cy + r * Math.sin(-2.46839094rad)) + " Z"
            }
        }

        // 轴线
        axis-0 := Path { x: 0; y: 0; width: parent.width; height: parent.height; stroke: Palette.foreground.with-alpha(0.08); stroke-width: 1px; fill: transparent;
            commands: { let cx = parent.width/2/1px; let cy = parent.height/2/1px; let r = parent.width/2*0.85/1px; let a = -1.57079633rad; "M "+cx+" "+cy+" L "+(cx+r*Math.cos(a))+" "+(cy+r*Math.sin(a)) } }
        axis-1 := Path { x: 0; y: 0; width: parent.width; height: parent.height; stroke: Palette.foreground.with-alpha(0.08); stroke-width: 1px; fill: transparent;
            commands: { let cx = parent.width/2/1px; let cy = parent.height/2/1px; let r = parent.width/2*0.85/1px; let a = -0.67319842rad; "M "+cx+" "+cy+" L "+(cx+r*Math.cos(a))+" "+(cy+r*Math.sin(a)) } }
        axis-2 := Path { x: 0; y: 0; width: parent.width; height: parent.height; stroke: Palette.foreground.with-alpha(0.08); stroke-width: 1px; fill: transparent;
            commands: { let cx = parent.width/2/1px; let cy = parent.height/2/1px; let r = parent.width/2*0.85/1px; let a = 0.22439948rad; "M "+cx+" "+cy+" L "+(cx+r*Math.cos(a))+" "+(cy+r*Math.sin(a)) } }
        axis-3 := Path { x: 0; y: 0; width: parent.width; height: parent.height; stroke: Palette.foreground.with-alpha(0.08); stroke-width: 1px; fill: transparent;
            commands: { let cx = parent.width/2/1px; let cy = parent.height/2/1px; let r = parent.width/2*0.85/1px; let a = 1.12199738rad; "M "+cx+" "+cy+" L "+(cx+r*Math.cos(a))+" "+(cy+r*Math.sin(a)) } }
        axis-4 := Path { x: 0; y: 0; width: parent.width; height: parent.height; stroke: Palette.foreground.with-alpha(0.08); stroke-width: 1px; fill: transparent;
            commands: { let cx = parent.width/2/1px; let cy = parent.height/2/1px; let r = parent.width/2*0.85/1px; let a = 2.01959527rad; "M "+cx+" "+cy+" L "+(cx+r*Math.cos(a))+" "+(cy+r*Math.sin(a)) } }
        axis-5 := Path { x: 0; y: 0; width: parent.width; height: parent.height; stroke: Palette.foreground.with-alpha(0.08); stroke-width: 1px; fill: transparent;
            commands: { let cx = parent.width/2/1px; let cy = parent.height/2/1px; let r = parent.width/2*0.85/1px; let a = 2.91719317rad; "M "+cx+" "+cy+" L "+(cx+r*Math.cos(a))+" "+(cy+r*Math.sin(a)) } }
        axis-6 := Path { x: 0; y: 0; width: parent.width; height: parent.height; stroke: Palette.foreground.with-alpha(0.08); stroke-width: 1px; fill: transparent;
            commands: { let cx = parent.width/2/1px; let cy = parent.height/2/1px; let r = parent.width/2*0.85/1px; let a = -2.46839094rad; "M "+cx+" "+cy+" L "+(cx+r*Math.cos(a))+" "+(cy+r*Math.sin(a)) } }

        // 数据区域填充
        data-fill := Path {
            x: 0; y: 0; width: parent.width; height: parent.height;
            fill: @linear-gradient(135deg, #2196f3 0%, #4CAF50 100%).with-alpha(0.35);
            stroke: #2196f3; stroke-width: 2.5px; stroke-line-join: round;
            commands: {
                let data = XiaoxinPageData.insight_7s_data;
                let cx = parent.width / 2 / 1px; let cy = parent.height / 2 / 1px; let r = parent.width / 2 * 0.85 / 1px;
                let v0 = data.length > 0 ? data[0].num / 100% : 0%;
                let v1 = data.length > 1 ? data[1].num / 100% : 0%;
                let v2 = data.length > 2 ? data[2].num / 100% : 0%;
                let v3 = data.length > 3 ? data[3].num / 100% : 0%;
                let v4 = data.length > 4 ? data[4].num / 100% : 0%;
                let v5 = data.length > 5 ? data[5].num / 100% : 0%;
                let v6 = data.length > 6 ? data[6].num / 100% : 0%;
                "M " + (cx + r * v0 * Math.cos(-1.57079633rad)) + " " + (cy + r * v0 * Math.sin(-1.57079633rad)) +
                " L " + (cx + r * v1 * Math.cos(-0.67319842rad)) + " " + (cy + r * v1 * Math.sin(-0.67319842rad)) +
                " L " + (cx + r * v2 * Math.cos(0.22439948rad)) + " " + (cy + r * v2 * Math.sin(0.22439948rad)) +
                " L " + (cx + r * v3 * Math.cos(1.12199738rad)) + " " + (cy + r * v3 * Math.sin(1.12199738rad)) +
                " L " + (cx + r * v4 * Math.cos(2.01959527rad)) + " " + (cy + r * v4 * Math.sin(2.01959527rad)) +
                " L " + (cx + r * v5 * Math.cos(2.91719317rad)) + " " + (cy + r * v5 * Math.sin(2.91719317rad)) +
                " L " + (cx + r * v6 * Math.cos(-2.46839094rad)) + " " + (cy + r * v6 * Math.sin(-2.46839094rad)) + " Z"
            }
        }

        // 数据点
        dot-0 := Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2196f3; border-color: white; border-width: 2px;
            x: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 0 ? d[0].num / 100% : 0%; let a = -1.57079633rad; let mr = parent.width/2*0.85; parent.width/2 + mr*v*Math.cos(a) - 4px }
            y: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 0 ? d[0].num / 100% : 0%; let a = -1.57079633rad; let mr = parent.width/2*0.85; parent.height/2 + mr*v*Math.sin(a) - 4px } }
        dot-1 := Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2196f3; border-color: white; border-width: 2px;
            x: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 1 ? d[1].num / 100% : 0%; let a = -0.67319842rad; let mr = parent.width/2*0.85; parent.width/2 + mr*v*Math.cos(a) - 4px }
            y: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 1 ? d[1].num / 100% : 0%; let a = -0.67319842rad; let mr = parent.width/2*0.85; parent.height/2 + mr*v*Math.sin(a) - 4px } }
        dot-2 := Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2196f3; border-color: white; border-width: 2px;
            x: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 2 ? d[2].num / 100% : 0%; let a = 0.22439948rad; let mr = parent.width/2*0.85; parent.width/2 + mr*v*Math.cos(a) - 4px }
            y: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 2 ? d[2].num / 100% : 0%; let a = 0.22439948rad; let mr = parent.width/2*0.85; parent.height/2 + mr*v*Math.sin(a) - 4px } }
        dot-3 := Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2196f3; border-color: white; border-width: 2px;
            x: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 3 ? d[3].num / 100% : 0%; let a = 1.12199738rad; let mr = parent.width/2*0.85; parent.width/2 + mr*v*Math.cos(a) - 4px }
            y: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 3 ? d[3].num / 100% : 0%; let a = 1.12199738rad; let mr = parent.width/2*0.85; parent.height/2 + mr*v*Math.sin(a) - 4px } }
        dot-4 := Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2196f3; border-color: white; border-width: 2px;
            x: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 4 ? d[4].num / 100% : 0%; let a = 2.01959527rad; let mr = parent.width/2*0.85; parent.width/2 + mr*v*Math.cos(a) - 4px }
            y: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 4 ? d[4].num / 100% : 0%; let a = 2.01959527rad; let mr = parent.width/2*0.85; parent.height/2 + mr*v*Math.sin(a) - 4px } }
        dot-5 := Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2196f3; border-color: white; border-width: 2px;
            x: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 5 ? d[5].num / 100% : 0%; let a = 2.91719317rad; let mr = parent.width/2*0.85; parent.width/2 + mr*v*Math.cos(a) - 4px }
            y: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 5 ? d[5].num / 100% : 0%; let a = 2.91719317rad; let mr = parent.width/2*0.85; parent.height/2 + mr*v*Math.sin(a) - 4px } }
        dot-6 := Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2196f3; border-color: white; border-width: 2px;
            x: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 6 ? d[6].num / 100% : 0%; let a = -2.46839094rad; let mr = parent.width/2*0.85; parent.width/2 + mr*v*Math.cos(a) - 4px }
            y: { let d = XiaoxinPageData.insight_7s_data; let v = d.length > 6 ? d[6].num / 100% : 0%; let a = -2.46839094rad; let mr = parent.width/2*0.85; parent.height/2 + mr*v*Math.sin(a) - 4px } }

        states [
            idle when !expanded: { opacity: 1; in-out { animate opacity { duration: 300ms; } } }
            hide when expanded: { opacity: 0; }
        ]
    }

    // === 小新动画头像 ===
    avatar := Rectangle {
        border-radius: Sizing.xlarge * 320%;
        background: @linear-gradient(135deg, Palette.accent-background 0%, #2196f3 100%);

        states [
            float-troubleshoot-popup when XiaoxinPageData.show-troubleshoot-popup: {
                width: Sizing.large;
                height: Sizing.large;
                x: troubleshoot-popup.x + 10px;
                y: troubleshoot-popup.y + 10px;
                opacity: 1;
                in-out {
                    animate width, height, x, y {
                        duration: 500ms;
                        easing: ease-in-out;
                    }
                }
            }
            float-troubleshoot-solution-popup when XiaoxinPageData.show-troubleshoot-solution-popup: {
                width: Sizing.large;
                height: Sizing.large;
                x: troubleshoot-solution-popup.x + 10px;
                y: troubleshoot-solution-popup.y + 10px;
                opacity: 1;
                in {
                    animate width, height, x, y {
                        duration: 500ms;
                        easing: ease-in-out;
                    }
                }
            }
            idle when !expanded: {
                width: Sizing.xlarge * 160%;
                height: Sizing.xlarge * 160%;
                x: (left-panel-width - self.width) * 5%;
                y: top-title.y + top-title.height + StyleMetrics.layout-spacing * 250%;
                opacity: 1;
            }
            expanded when expanded && !XiaoxinPageData.show-edu-widget: {
                width: Sizing.xlarge * 320%;
                height: Sizing.xlarge * 320%;
                x: (root.width - self.width) / 2;
                y: StyleMetrics.layout-spacing * 250% ;
                opacity: 1;
                in-out {
                    animate width, height {
                        duration: 700ms;
                        easing: ease-out;
                    }
                    animate x, y {
                        duration: 1500ms;
                        easing: ease-in-out;
                    }
                }
            }
            faded when XiaoxinPageData.show-edu-widget: {
                width: Sizing.xlarge * 320%;
                height: Sizing.xlarge * 320%;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                opacity: 0;
                in-out {
                    animate opacity { duration: 300ms; }
                }
            }
        ]

        ta := TouchArea {
            clicked => {
                expanded = true;
            }
        }

        Rectangle {
            border-radius: parent.border-radius;
            clip: true;
            // states [
            //     normal when !ta.pressed: {
                    width: parent.width - 20px;
                    height: parent.height - 20px;
            //     }
            //     pressed when ta.pressed: {
            //         width: parent.width * 70%;
            //         height: parent.height * 70%;
            //     }
            // ]
            // animate width, height { duration: 20ms; }
            Image {
                width: 100%;
                height: 100%;
                source: @image-url("icon/xiaoxin.png");
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
