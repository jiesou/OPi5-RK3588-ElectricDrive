import { XiaoxinPageData } from "xiaoxin-page-data.slint";
import { CameraViewport } from "camera-viewport.slint";
import { Palette, Button } from "std-widgets.slint";
import { ElectricEduWidget } from "electric-edu-widget.slint";

// 故障主动发现弹窗
component TroubleshootPopup inherits Rectangle {
    background: Palette.background;
    width: 500px;
    height: 200px;
    border-radius: 16px;
    border-width: 2px;
    border-color: #4CAF50;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        // alignment: start;

        HorizontalLayout {
            alignment: center;
            Text {
                text: XiaoxinPageData.troubleshoot-title;
                font-size: 32px;
                font-weight: 600;
                y: 4px;
                color: Palette.foreground;
                horizontal-alignment: center;
                wrap: word-wrap;
                width: parent.width - 48px;
            }
        }

        HorizontalLayout {
            spacing: 16px;
            horizontal-stretch: 0;

            Button {
                text: "帮帮我";
                primary: true;
                clicked => {
                    XiaoxinPageData.show-troubleshoot-popup = false;
                    XiaoxinPageData.show-troubleshoot-solution-popup = true;
                }
            }

            Button {
                text: "我会自己解决";
                clicked => {
                    XiaoxinPageData.show-troubleshoot-popup = false;
                }
            }
        }
    }
}

// 故障解决方案弹窗
component SolutionPopup inherits Rectangle {
    background: Palette.background;
    width: 500px;
    height: 380px;
    border-radius: 16px;
    border-width: 2px;
    border-color: #2196F3;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "小新智能体提醒你";
            font-size: 24px;
            font-weight: 700;
            color: Palette.foreground;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground;
        }

        Text {
            text: XiaoxinPageData.troubleshoot-solution-desc;
            font-size: 18px;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: word-wrap;
            width: parent.width - 60px;
        }

        Rectangle {
            height: 8px;
        }

        Button {
            text: "我知道了";
            primary: true;
            clicked => {
                XiaoxinPageData.show-troubleshoot-solution-popup = false;
            };
        }
    }
}

export component XiaoxinPage {
    in property <length> root-screen-width;
    height: 100%;
    width: 100%;

    private property <bool> is-portrait: root.height > root.width;
    property <length> left-panel-width: is-portrait ? root.width : (root.root-screen-width < 801px ? root.width / 2.1 : root.width / 1.7);

    // 核心状态：小新头已展开
    in-out property <bool> expanded: false;

    // 主页面
    Rectangle {
        background: Palette.background;

        // 顶部标题
        Text {
            x: 8px;
            y: 8px;
            text: "电拖实训端侧 AI 平台";
            font-size: 24px;
            font-weight: 600;
            color: Palette.foreground;
            states [
                idle when !expanded: { opacity: 1; }
                hidden when expanded: { opacity: 0; }
            ]
            animate opacity { duration: 200ms; }
        }

        // 左侧内容面板
        VerticalLayout {
            spacing: 24px;
            alignment: center;
            width: left-panel-width;
            height: is-portrait ? root.height * 0.5 : root.height;
            x: 0;
            y: 0;
            padding-top: 180px;
            states [
                idle when !expanded: { opacity: 1; }
                hidden when expanded: { opacity: 0; }
            ]
            animate opacity { duration: 200ms; }

            Text {
                text: XiaoxinPageData.status-text;
                font-size: 36px;
                font-weight: 800;
                color: Palette.foreground;
                horizontal-alignment: center;
            }

            // 装饰分隔线
            Rectangle {
                in-out property <bool> anim_end;
                x: (parent.width - self.width) / 2;
                width: anim_end ? parent.width * 0.9 : parent.width * 0.4;
                height: 8px;
                background: anim_end ? @linear-gradient(90deg, transparent 0%, #d0bcff 30%, #2196f3 50%, #d0bcff 70%, transparent 100%) : @linear-gradient(90deg, transparent 0%, #d0bcff 10%, #2196f3 50%, #d0bcff 90%, transparent 100%);
                animate background, width {
                    duration: 1000ms;
                    easing: ease-in-out;
                }
                Timer {
                    interval: 1000ms;
                    triggered() => {
                        parent.anim_end = !parent.anim_end;
                    }
                }
            }
        }

        // 右侧摄像头画面
        VerticalLayout {
            width: is-portrait ? root.width : (root.root-screen-width < 801px ? root.width / 1.9 : root.width / 2.45);
            height: is-portrait ? root.height * 0.5 : root.height;
            x: is-portrait ? 0 : root.width - self.width;
            y: is-portrait ? root.height * 0.5 : 0;

            CameraViewport {
                width: 100%;
                height: 100%;
                frame: XiaoxinPageData.camera-frame;
                running: XiaoxinPageData.xiaoxin-running;
                request-camera-frame => {
                    XiaoxinPageData.request-xiaoxin-frame();
                }
            }
        }
    }

    // === 小新动画智能提示文字 ===
    Rectangle {
        width: root.width;
        height: 80px;
        y: parent.height - self.height - 30px;

        states [
            hidden when !expanded || XiaoxinPageData.show-edu-widget: {
                opacity: 0;
            }
            visible-state when expanded && !XiaoxinPageData.show-edu-widget: {
                opacity: 1;
                in {
                    animate opacity {
                        duration: 300ms;
                        delay: 300ms;
                    }
                }
            }
        ]

        Text {
            text: "小新在呢，需要什么帮助？";
            font-size: 36px;
            font-weight: 700;
            color: Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 定时器：展开后延迟显示 Edu Widget
    Timer {
        interval: 2000ms;
        running: expanded && !XiaoxinPageData.show-edu-widget;
        triggered() => {
            XiaoxinPageData.show-edu-widget = true;
        }
    }

    // === 教育资源 Edu Widget ===
    Rectangle {
        background: Palette.background;
        states [
            hidden when !XiaoxinPageData.show-edu-widget: {
                width: root.width * 0.8;
                height: root.height * 0.8;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                opacity: 0;
            }
            visible-state when XiaoxinPageData.show-edu-widget: {
                width: root.width;
                height: root.height;
                opacity: 1;
                in {
                    animate width, height, x, y, opacity { duration: 300ms; easing: ease-out; }
                }
            }
        ]

        ElectricEduWidget {
            property <bool> closing: false;
            closed => {
                XiaoxinPageData.show-edu-widget = false;
                // expanded = false;
                closing = true;
            }
            Timer {
                interval: 300ms;
                running: parent.closing;
                triggered() => {
                    expanded = false;
                    closing = false;
                }
            }
        }
    }

    // === 故障发现 ===
    // 故障主动发现弹窗
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-popup;
        troubleshoot-popup := TroubleshootPopup { }
    }

    // 故障解决方案弹窗
    Rectangle {
        visible: XiaoxinPageData.show-troubleshoot-solution-popup;
        troubleshoot-solution-popup := SolutionPopup { }
    }

Timer {
    running: true;
    interval: 1000ms;
    triggered => { XiaoxinPageData.show-troubleshoot-popup = true; self.running = false; }
}

    // === 小新动画头像 ===
    avatar := Rectangle {
        width: 160px;
        height: 160px;
        border-radius: 360px;
        background: @linear-gradient(135deg, Palette.accent-background 0%, #2196f3 100%);

        states [
            float-troubleshoot-popup when XiaoxinPageData.show-troubleshoot-popup: {
                width: 80px;
                height: 80px;
                x: troubleshoot-popup.x + 10px;
                y: troubleshoot-popup.y + 10px;
                opacity: 1;
                in-out {
                    animate width, height, x, y {
                        duration: 500ms;
                        easing: ease-in-out;
                    }
                }
            }
            float-troubleshoot-solution-popup when XiaoxinPageData.show-troubleshoot-solution-popup: {
                width: 80px;
                height: 80px;
                x: troubleshoot-solution-popup.x + 10px;
                y: troubleshoot-solution-popup.y + 10px;
                opacity: 1;
                in-out {
                    animate width, height, x, y {
                        duration: 500ms;
                        easing: ease-in-out;
                    }
                }
            }
            idle when !expanded: {
                width: 160px;
                height: 160px;
                x: (left-panel-width - self.width) / 2;
                y: root.height * 0.5 - self.width + 40px;
                opacity: 1;
            }
            expanded when expanded && !XiaoxinPageData.show-edu-widget: {
                width: 240px;
                height: 240px;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2 - 50px;
                opacity: 1;
                in-out {
                    animate width, height {
                        duration: 700ms;
                        easing: ease-out;
                    }
                    animate x, y {
                        duration: 1500ms;
                        easing: ease-in-out;
                    }
                }
            }
            faded when XiaoxinPageData.show-edu-widget: {
                width: 240px;
                height: 240px;
                x: (root.width - 240px) / 2;
                y: (root.height - 240px) / 2;
                opacity: 0;
                in-out {
                    animate opacity { duration: 300ms; }
                }
            }
        ]

        ta := TouchArea {
            clicked => {
                expanded = true;
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: parent.border-radius;
            background: Palette.background;
            clip: true;
            states [
                normal when !ta.pressed: {
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                }
                pressed when ta.pressed: {
                    width: (parent.width - 20px) * 0.9;
                    height: (parent.height - 20px) * 0.9;
                }
            ]
            animate width, height {
                 duration: 20ms;
            }
            Image {
                width: 100%;
                height: 100%;
                source: @image-url("icon/xiaoxin.png");
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
