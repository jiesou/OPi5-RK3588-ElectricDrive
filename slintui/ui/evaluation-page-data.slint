export global EvaluationPageData {
    in-out property<image> camera-frame;
    in-out property<bool> evaluation-running: true;
    in-out property<string> server-ip: "";
    in-out property<bool> udp-enabled: false;
    in-out property<bool> tile-inference-enabled: false;
    in-out property<int> score: 86;
    in-out property <string> detection-description: "满分 100\n-2x2（号码管未套2个，每个2分）";
    in-out property<string> npu-usage: "0: 0%";
    in-out property<float> total-detect-ms: 70.7;

    callback request-camera-frame();
    callback save-settings(string);
    callback toggle-udp(bool);
    callback toggle-tile-inference(bool);
    callback capture-dataset();
    callback capture-shot();
}
