import { Button, LineEdit, VerticalBox, GroupBox } from "std-widgets.slint";

export component SettingsWidget {
    in-out property <string> server_ip;
    callback save_settings(string);

    GroupBox {
        title: "设置";
        VerticalBox {
            spacing: 8px;
            alignment: start;

            Text {
                text: "SERVER IP:";
            }

            LineEdit {
                min-width: 200px;
                text <=> root.server_ip;
                placeholder-text: "192.168.100.XXX";
            }

            Button {
                text: "保存";
                clicked => {
                    root.save_settings(root.server_ip);
                }
            }
        }
    }
}
