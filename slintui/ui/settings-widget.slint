import { Button, LineEdit, GroupBox } from "std-widgets.slint";
import { EvaluationPageData } from "evaluation-page-data.slint";

export component SettingsWidget {
    GroupBox {
        title: "设置";
        width: 100%;
        Rectangle {
            VerticalLayout {
                spacing: 8px;

                LineEdit {
                    min-width: 200px;
                    text <=> EvaluationPageData.server-ip;
                    placeholder-text: "SERVER_IP";
                }
            }
            btn := Button {
                x: root.width - self.width - 40px;
                text: "保存";
                clicked => {
                    EvaluationPageData.save-settings(EvaluationPageData.server-ip);
                }
            }
        }
    }
}
